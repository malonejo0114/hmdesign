{
  "version": "1.0.0",
  "metadata": {
    "source_policy": "Tropical zodiac, geocentric longitude, Swiss Ephemeris compatible",
    "normalization": {
      "datetime_standard": "ISO-8601",
      "timezone_database": "IANA",
      "compute_in_utc": true,
      "design_offset": {
        "type": "solar_longitude_delta",
        "degrees": 88
      }
    }
  },
