    },
    {
      "id": "root",
      "name": "Root",
      "kind": "motor"
    }
  ],
  "type_rules": [
    {
      "type": "Reflector",
      "rule": "defined_centers_count == 0",
      "strategy": "Wait a lunar cycle"
    },
    {
      "type": "Manifesting Generator",
      "rule": "sacral_defined && motor_to_throat_connection",
      "strategy": "Wait to respond, then inform"
    },
    {
      "type": "Generator",
      "rule": "sacral_defined && !motor_to_throat_connection",
      "strategy": "Wait to respond"
    },
    {
      "type": "Manifestor",
      "rule": "!sacral_defined && non_sacral_motor_to_throat_connection",
      "strategy": "Inform before action"
    },
    {
      "type": "Projector",
      "rule": "!sacral_defined && !motor_to_throat_connection && defined_centers_count > 0",
      "strategy": "Wait for recognition and invitation"
    }
  ],
  "authority_priority": [
    "Emotional",
    "Sacral",
    "Splenic",
    "Ego",
    "Self-Projected",
    "Mental",
    "Lunar"
  ],
  "authority_rules": {
    "Emotional": "solar_plexus_defined",
    "Sacral": "!solar_plexus_defined && sacral_defined",
    "Splenic": "!solar_plexus_defined && !sacral_defined && spleen_defined",
    "Ego": "!solar_plexus_defined && !sacral_defined && !spleen_defined && ego_defined",
    "Self-Projected": "throat_defined && g_defined && g_to_throat_connection",
    "Mental": "projector_type && no_inner_authority_center_defined",
    "Lunar": "reflector_type"
  },
  "definition_rules": {
    "single": "all_defined_centers_connected_as_one_component",
    "split": "two_components",
    "triple_split": "three_components",
    "quadruple_split": "four_components"
