    },
    {
      "id": "g",
      "name": "G",
      "kind": "identity"
    },
    {
      "id": "ego",
      "name": "Heart/Ego",
      "kind": "motor"
    },
    {
      "id": "sacral",
      "name": "Sacral",
      "kind": "motor"
    },
    {
      "id": "solar_plexus",
      "name": "Solar Plexus",
      "kind": "motor"
    },
    {
      "id": "spleen",
